# Copy to .env and change the values
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Where Grafana sends alert emails
ALERT_EMAIL=you@example.com

# Optional: SMTP server Grafana uses to send those emails
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=grafana@example.com
